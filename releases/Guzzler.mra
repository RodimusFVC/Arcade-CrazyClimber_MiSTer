<misterromdescription>
    <name>Guzzler</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Guzzler</series>
    <year>1983</year>
    <manufacturer>Tehkan</manufacturer>
    <category>Maze</category>

    <setname>guzzler</setname>
    <parent>guzzler</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Button 1,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,10">
        <dip name="Lives" bits="0,1" ids="3,4,5,Infinite (Cheat)"/>
        <dip name="Bonus Life" bits="2,3" ids="30K Every 100K,20K Every 50K,30K Only,None"/>
        <dip name="Coin A" bits="4,5" ids="1C/1C,2C/1C,1C/2C,1C/3C"/>
        <dip name="Coin B" bits="6,7" ids="1C/1C,1C/2C,1C/3C,1C/6C"/>
        <dip name="Cabinet" bits="12" ids="Cocktail,Upright"/>
        <dip name="High Score Names" bits="13" ids="10 Letters,3 Letters"/>
        <dip name="Difficulty" bits="14,15" ids="Easy,Medium,Hard,Hardest"/>
    </switches>

    <!-- Index 2: CPU 0x0000 + E000 at 0x8000, sound CPU 0xA000, tile planes 0xC000 (8K slots), big sprite 0x12000, palette PROMs 0x15000 -->
    <rom index="2" md5="none" zip="guzzler.zip">
        <part crc="58aaa1e9" name="guzz-01.bin"/>
        <part crc="f80ceb17" name="guzz-02.bin"/>
        <part crc="e63c65a2" name="guzz-03.bin"/>
        <part crc="45be42f5" name="guzz-04.bin"/>
        <part crc="61ee00b7" name="guzz-16.bin"/>
        <part crc="f3754d9e" name="guzz-12.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="afc464e2" name="guzz-13.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="acbdfe1f" name="guzz-14.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="66978c05" name="guzz-15.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="ec2e9d86" name="guzz-11.bin"/>
        <part crc="bd3f0bf7" name="guzz-10.bin"/>
        <part crc="18927579" name="guzz-09.bin"/>
        <part crc="f86930c1" name="guzzler.003"/>
        <part crc="b566ea9e" name="guzzler.002"/>
        <part crc="69089495" name="guzzler.001"/>
    </rom>

    <!-- Index 1: control layout, board flags (see Arcade-CrazyClimber.sv) -->
    <rom index="1">
        <part>03 D0</part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 00 FF FF 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 85 84 00 50 00 55
            00 00 80 07 00 06 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="86"></nvram>

    <remark>Guzzler (Tehkan)</remark>
    <mratimestamp>20260927000000</mratimestamp>
</misterromdescription>

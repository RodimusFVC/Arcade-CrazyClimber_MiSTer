<misterromdescription>
    <name>Tangram Q</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Tangram Q</series>
    <year>1983</year>
    <manufacturer>SNK</manufacturer>
    <category>Puzzle</category>

    <setname>tangramq</setname>
    <parent>tangramq</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Button 1,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="8E,FF">
        <dip name="Lives" bits="0,1" ids="1,2,3,5"/>
        <dip name="Freeze" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coinage" bits="4,6" ids="1C/1C,1C/2C,1C/3C,1C/5C,1C/6C,2C/1C,3C/1C,4C/1C"/>
        <dip name="Cabinet" bits="7" ids="Cocktail,Upright"/>
        <dip name="Free Play" bits="11" ids="On,Off"/>
        <dip name="Infinite Lives" bits="12" ids="On,Off"/>
    </switches>

    <!-- Index 5: CPU 0x0000, tiles 0x6000, big sprite 0xA000, sound CPU 0xC000, palette PROMs 0xE000 -->
    <rom index="5" md5="none" zip="tangramq.zip">
        <part crc="dff92169" name="m1.k5"/>
        <part crc="1cbade75" name="m2.k4"/>
        <part repeat="0x2000">00</part>
        <part crc="c7c3ffe1" name="f1.h4"/>
        <part crc="dbc13c1f" name="f2.h2"/>
        <part crc="77d21b84" name="b2.e17"/>
        <part crc="f3ec2562" name="b1.e19"/>
        <part crc="05af38f6" name="s1.a6"/>
        <part crc="b3fc1505" name="mb7051_m02.m6"/>
        <part crc="26aada9e" name="mb7051_m02.m7"/>
        <part crc="676b3166" name="mb7051_m02.m8"/>
    </rom>

    <!-- Index 1: control layout, board flags (see Arcade-CrazyClimber.sv) -->
    <rom index="1">
        <part>05 10 08</part>
    </rom>

    <remark>Tangram Q (SNK)</remark>
    <mratimestamp>20260927000000</mratimestamp>
</misterromdescription>

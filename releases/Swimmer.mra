    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Button 1,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,30">
        <dip name="Lives" bits="0,1" ids="3,4,5,Infinite (Cheat)"/>
        <dip name="Bonus Life" bits="2,3" ids="10000,20000,30000,None"/>
        <dip name="Coin A" bits="4,5" ids="1C/1C,2C/1C,1C/2C,1C/3C"/>
        <dip name="Coin B" bits="6,7" ids="1C/1C,1C/2C,1C/3C,1C/6C"/>
        <dip name="Cabinet" bits="12" ids="Cocktail,Upright"/>
        <dip name="Demo Sounds" bits="13" ids="Off,On"/>
        <dip name="Difficulty" bits="14,15" ids="Easy,Hard,Harder,Hardest"/>
    </switches>

    <!-- Index 2: CPU 0x0000 + E000 at 0x8000, sound CPU 0xA000, tile planes 0xC000 (8K slots), big sprite 0x12000, palette PROMs 0x15000 -->

<misterromdescription>
    <name>Le Bagnard (Bootleg on Crazy Kong Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Bagman</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Platform</category>

    <setname>bagmanf</setname>
    <parent>bagman</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Jump,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FE">
        <dip name="Lives" bits="0,1" ids="5,4,3,2"/>
        <dip name="Coinage" bits="2" ids="2C/1C 1C/1C 1C/3C 1C/7C,1C/1C 1C/2C 1C/6C 1C/14C"/>
        <dip name="Difficulty" bits="3,4" ids="Hardest,Hard,Medium,Easy"/>
        <dip name="Language" bits="5" ids="French,English"/>
        <dip name="Bonus Life" bits="6" ids="40000,30000"/>
        <dip name="Cabinet" bits="7" ids="Cocktail,Upright"/>
    </switches>

    <!-- Index 0: CPU 0x0000, tiles 0x6000, big sprite 0xA000, samples 0xB000, palette PROMs 0xD000, speech PROM 0xD200, speech ROMs 0xE000 -->
    <rom index="0" md5="none" zip="bagmanf.zip|bagman.zip">
        <part crc="e0156191" name="01.d5.bin"/>
        <part crc="7b758982" name="02.f5.bin"/>
        <part crc="302a077b" name="03.h5.bin"/>
        <part crc="b704d761" name="04.k5.bin"/>
        <part crc="4f0088ab" name="05.l5.bin"/>
        <part crc="91570033" name="2732 05 pos dboard.bin"/>
        <part crc="4a0a6b55" name="12.k11.bin"/>
        <part crc="8043bc1a" name="11.h11.bin"/>
        <part crc="c680ef04" name="10.n11.bin"/>
        <part crc="060b044c" name="09.l11.bin"/>
        <part repeat="0x3000">00</part>
        <part crc="26aada9e" name="u6"/>
        <part crc="b3fc1505" name="v6"/>
        <part crc="676b3166" name="t6"/>
        <part repeat="0x1A0">00</part>
        <part crc="c58a4f6a" name="daughterboard.prom"/>
        <part repeat="0xDE0">00</part>
        <part crc="2e0057ff" name="2732 07 pos dboard.bin"/>
        <part crc="b2120edd" name="2732 08 pos dboard.bin"/>
    </rom>

    <!-- Index 1: control layout, board flags (see Arcade-CrazyClimber.sv) -->
    <rom index="1">
        <part>01 18 40</part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 00 FF FF 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 62 17 00 50 00 10
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="80"></nvram>

    <remark>Le Bagnard (Bootleg on Crazy Kong Hardware)</remark>
    <mratimestamp>20260927000000</mratimestamp>
</misterromdescription>

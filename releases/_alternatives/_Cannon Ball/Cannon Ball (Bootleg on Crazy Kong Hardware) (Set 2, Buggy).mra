<misterromdescription>
    <name>Cannon Ball (Bootleg on Crazy Kong Hardware) (Set 2, Buggy)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Cannon Ball</series>

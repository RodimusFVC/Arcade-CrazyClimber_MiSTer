<misterromdescription>
    <name>Cannon Ball (Bootleg On Crazy Kong Hardware) (Set 1, Buggy)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Cannon Ball</series>
    <year>1985</year>
    <manufacturer>bootleg (Soft)</manufacturer>
    <category>Shooter</category>

    <setname>cannonb</setname>
    <parent>cannonbp</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="E7">
        <dip name="Display" bits="0,1" ids="None,Scores Only,Progress Bars Only,Scores and Progress Bars"/>
        <dip name="Cabinet" bits="2" ids="Cocktail,Upright"/>
        <dip name="Lives" bits="3,4" ids="3,4,5,6"/>
    </switches>

    <!-- Index 0: CPU 0x0000, tiles 0x6000, big sprite 0xA000, samples 0xB000, palette PROMs 0xD000 -->

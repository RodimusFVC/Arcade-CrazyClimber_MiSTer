<misterromdescription>
    <name>Crazy Kong Part II (Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Crazy Kong</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Platform</category>

    <setname>ckongpt2b2</setname>
    <parent>ckongpt2</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Jump,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="80">
        <dip name="Lives" bits="0,1" ids="2,3,4,5"/>
        <dip name="Bonus Life" bits="2,3" ids="7000,10000,15000,20000"/>
        <dip name="Coinage" bits="4,6" ids="1C/1C,2C/1C,1C/2C,3C/1C,1C/3C,4C/1C,1C/4C,5C/1C"/>
        <dip name="Cabinet" bits="7" ids="Cocktail,Upright"/>
    </switches>

    <!-- Index 0: CPU 0x0000, tiles 0x6000, big sprite 0xA000, samples 0xB000, palette PROMs 0xD000 -->
    <rom index="0" md5="none" zip="ckongpt2b2.zip|ckongpt2.zip">
        <part crc="1c21386f" name="0.bin"/>
        <part crc="5dc1aaba" name="1.bin"/>
        <part crc="c9054c94" name="2.bin"/>
        <part crc="84903b9d" name="3.bin"/>
        <part crc="ae159192" name="4.bin"/>
        <part crc="966bc9ab" name="5.bin"/>
        <part crc="2dcedd12" name="d.bin"/>
        <part crc="fa7cbd91" name="c.bin"/>
        <part crc="3375b3bd" name="b.bin"/>
        <part crc="5655cc11" name="a.bin"/>
        <part crc="d1352c31" name="9.bin"/>
        <part crc="a7a2fdbd" name="8.bin"/>
        <part crc="5f0bcdfb" name="7.bin"/>
        <part crc="9003ffbd" name="6.bin"/>
        <part crc="d3b84067" name="prom.bin"/>
        <part crc="26aada9e" name="prom.t6"/>
        <part crc="676b3166" name="prom.u6"/>
    </rom>

    <!-- Index 1: control layout, board flags (see Arcade-CrazyClimber.sv) -->
    <rom index="1">
        <part>01 18</part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 00 FF FF 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 61 00 00 AA 94 92
            00 00 60 B8 00 03 50 00
        </part>
    </rom>
    <rom index="4"></rom>

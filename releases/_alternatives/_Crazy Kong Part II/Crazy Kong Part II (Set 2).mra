<misterromdescription>
    <name>Crazy Kong Part II (Set 2)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Crazy Kong</series>

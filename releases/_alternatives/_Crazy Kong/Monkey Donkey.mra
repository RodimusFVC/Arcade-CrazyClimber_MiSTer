<misterromdescription>
    <name>Monkey Donkey</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Crazy Kong</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Platform</category>

    <setname>monkeyd</setname>
    <parent>ckong</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Jump,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="80">
        <dip name="Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="2,3" ids="7000,10000,15000,20000"/>
        <dip name="Coinage" bits="4,6" ids="1C/1C,2C/1C,1C/2C,3C/1C,1C/3C,4C/1C,1C/4C,5C/1C"/>
        <dip name="Cabinet" bits="7" ids="Cocktail,Upright"/>
    </switches>

    <!-- Index 0: CPU 0x0000, tiles 0x6000, big sprite 0xA000, samples 0xB000, palette PROMs 0xD000 -->
    <rom index="0" md5="none" zip="monkeyd.zip|ckong.zip">
        <part crc="2171cac3" name="ck7.bin"/>
        <part crc="88b83ff7" name="ck8.bin"/>
        <part crc="cff2af47" name="ck9.bin"/>
        <part crc="520fa4de" name="ck10.bin"/>
        <part crc="d1db1bb0" name="md5l.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="a8916dc8" name="ck6.bin"/>
        <part crc="cd3b5dde" name="ck5.bin"/>
        <part crc="b62a0367" name="ck4.bin"/>
        <part crc="61122c5e" name="ck3.bin"/>
        <part crc="f67c80f1" name="md_ck2.bin"/>
        <part crc="80eb517d" name="md_ck1.bin"/>
        <part crc="5f0bcdfb" name="cc13j.bin"/>
        <part crc="2eb23b60" name="ck12.bin"/>
        <part crc="751c3325" name="ck6v.bin"/>
        <part crc="ab1940fa" name="ck6u.bin"/>
        <part crc="b4e827a5" name="ck6t.bin"/>
    </rom>

    <!-- Index 1: control layout, board flags (see Arcade-CrazyClimber.sv) -->
    <rom index="1">
        <part>01 18</part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 62 FE 5A 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 61 00 00 AA 94 92
            00 00 60 B8 00 03 50 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="173"></nvram>

    <remark>Monkey Donkey (Bootleg)</remark>
    <mratimestamp>20260927000000</mratimestamp>
</misterromdescription>

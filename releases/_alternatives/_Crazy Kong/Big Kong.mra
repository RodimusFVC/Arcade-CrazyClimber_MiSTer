<misterromdescription>
    <name>Big Kong</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Crazy Kong</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Platform</category>

    <setname>bigkong</setname>
    <parent>ckong</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Jump,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="80">
        <dip name="Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="2,3" ids="7000,10000,15000,20000"/>
        <dip name="Coinage" bits="4,6" ids="1C/1C,2C/1C,1C/2C,3C/1C,1C/3C,4C/1C,1C/4C,5C/1C"/>
        <dip name="Cabinet" bits="7" ids="Cocktail,Upright"/>
    </switches>

    <!-- Index 0: CPU 0x0000, tiles 0x6000, big sprite 0xA000, samples 0xB000, palette PROMs 0xD000 -->
    <rom index="0" md5="none" zip="bigkong.zip|ckong.zip">
        <part crc="4c9102f1" name="dk01f7_2532.d5"/>
        <part crc="1683e9ae" name="dk02f8_2532.f5"/>
        <part crc="073eea32" name="dk03f9_2532.h5"/>
        <part crc="0aab0334" name="dk04f10_2532.k5"/>
        <part crc="45be1c6a" name="dk05f11_2532.l5"/>
        <part crc="966bc9ab" name="n05-12.bin"/>
        <part crc="2dcedd12" name="n11-06.bin"/>
        <part crc="fa7cbd91" name="l11-05.bin"/>
        <part crc="3375b3bd" name="k11-04.bin"/>
        <part crc="5655cc11" name="h11-03.bin"/>
        <part crc="d1352c31" name="c11-02.bin"/>
        <part crc="a7a2fdbd" name="a11-01.bin"/>
        <part crc="5f0bcdfb" name="cc13j.bin"/>
        <part crc="9003ffbd" name="cc12j.bin"/>
        <part crc="b3fc1505" name="prom.v6"/>
        <part crc="26aada9e" name="prom.u6"/>
        <part crc="676b3166" name="prom.t6"/>
    </rom>

    <!-- Index 1: control layout, board flags (see Arcade-CrazyClimber.sv) -->
    <rom index="1">
        <part>01 18</part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 00 FF FF 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 61 09 00 A1 00 92
            00 00 60 B8 00 03 50 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="164"></nvram>

    <remark>Big Kong (Bootleg)</remark>

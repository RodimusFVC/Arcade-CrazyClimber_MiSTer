        <part crc="cae9e2bf" name="o50b-1" offset="0x0" length="0x800"/>
        <part crc="fba82114" name="o50b-2" offset="0x0" length="0x800"/>
        <part crc="cae9e2bf" name="o50b-1" offset="0x800" length="0x800"/>

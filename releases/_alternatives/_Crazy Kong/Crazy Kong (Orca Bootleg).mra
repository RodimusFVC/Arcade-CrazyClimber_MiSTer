<misterromdescription>
    <name>Crazy Kong (Orca Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Crazy Kong</series>
    <year>1981</year>
    <manufacturer>bootleg (Orca)</manufacturer>
    <category>Platform</category>

    <setname>ckongo</setname>
    <parent>ckong</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Jump,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="80">
        <dip name="Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="2,3" ids="7000,10000,15000,20000"/>
        <dip name="Coinage" bits="4,6" ids="1C/1C,2C/1C,1C/2C,3C/1C,1C/3C,4C/1C,1C/4C,5C/1C"/>
        <dip name="Cabinet" bits="7" ids="Cocktail,Upright"/>
    </switches>

    <!-- Index 0: CPU 0x0000, tiles 0x6000, big sprite 0xA000, samples 0xB000, palette PROMs 0xD000 -->
    <rom index="0" md5="none" zip="ckongo.zip|ckong.zip">
        <part crc="8bfb4623" name="o55a-1"/>
        <part crc="9ae8089b" name="o55a-2"/>

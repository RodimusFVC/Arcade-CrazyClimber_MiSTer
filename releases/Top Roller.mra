<misterromdescription>
    <name>Top Roller</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Top Roller</series>
    <year>1983</year>
    <manufacturer>Jaleco</manufacturer>
    <category>Driving</category>

    <setname>toprollr</setname>
    <parent>toprollr</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Button 1,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="80,00">
        <dip name="Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Coin A" bits="2,4" ids="1C/1C,2C/1C,3C/1C,4C/1C,1C/2C,1C/3C,2C/3C,Free Play"/>
        <dip name="Bonus Life" bits="5" ids="Every 30000,Every 50000"/>
        <dip name="Difficulty" bits="6" ids="Easy,Hard"/>
        <dip name="Cabinet" bits="7" ids="Cocktail,Upright"/>
        <dip name="Coin B" bits="8,10" ids="1C/1C,Invalid,3C/1C,4C/1C,1C/2C,1C/3C,2C/3C,Free Play"/>
    </switches>

    <!-- Index 7: banks 0x0000 (3 x 16K), fixed 4000-5FFF 0xC000, CPU C000-FFFF 0x10000, tiles 0x14000, big sprite 0x18000, bg 0x1C000, samples 0x1E000, PROMs 0x20000 -->

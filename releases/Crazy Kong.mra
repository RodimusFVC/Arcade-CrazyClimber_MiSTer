<misterromdescription>
    <name>Crazy Kong</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Crazy Kong</series>
    <year>1981</year>
    <manufacturer>Kyoei / Falcon</manufacturer>
    <category>Platform</category>

    <setname>ckong</setname>
    <parent>ckong</parent>
    <mameversion>0289</mameversion>
    <rbf>CrazyClimber</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Jump,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="80">
        <dip name="Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="2,3" ids="7000,10000,15000,20000"/>
        <dip name="Coinage" bits="4,6" ids="1C/1C,2C/1C,1C/2C,3C/1C,1C/3C,4C/1C,1C/4C,5C/1C"/>
        <dip name="Cabinet" bits="7" ids="Cocktail,Upright"/>
    </switches>

    <!-- Index 0: CPU 0x0000, tiles 0x6000, big sprite 0xA000, samples 0xB000, palette PROMs 0xD000 -->
    <rom index="0" md5="none" zip="ckong.zip">
        <part crc="2171cac3" name="falcon7"/>
        <part crc="88b83ff7" name="falcon8"/>
        <part crc="cff2af47" name="falcon9"/>
        <part crc="6b2ecf23" name="falcon10"/>
        <part crc="327dcadf" name="falcon11"/>
        <part repeat="0x1000">00</part>
        <part crc="a8916dc8" name="falcon6"/>
        <part crc="cd3b5dde" name="falcon5"/>
        <part crc="b62a0367" name="falcon4"/>
        <part crc="61122c5e" name="falcon3"/>
        <part crc="f67c80f1" name="falcon2"/>
        <part crc="80eb517d" name="falcon1"/>
        <part crc="5f0bcdfb" name="falcon13"/>
        <part crc="9003ffbd" name="falcon12"/>
        <part crc="751c3325" name="ck6v.bin"/>
        <part crc="ab1940fa" name="ck6u.bin"/>
        <part crc="b4e827a5" name="ck6t.bin"/>
    </rom>

    <!-- Index 1: control layout, board flags (see Arcade-CrazyClimber.sv) -->
    <rom index="1">
        <part>01 18</part>
    </rom>

    <remark>Crazy Kong (Kyoei / Falcon)</remark>
    <mratimestamp>20260927000000</mratimestamp>
</misterromdescription>
